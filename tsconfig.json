{
    "exclude": [
        "node_modules"
    ],
    "include": [
        "resources/**/*"
    ],
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "jsx": "preserve",
        "moduleResolution": "node",
        "strict": true,
        "baseUrl": "." ,
        "paths": {
            "@/*": [
                "resources/*"
            ]
        },
        "types": ["vite/client"],
        "lib": [
            "esnext",
            "dom"
        ],
      "allowSyntheticDefaultImports": true
    }
}